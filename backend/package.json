{
  "name": "smart-farm-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "build:cloud": "tsc -p tsconfig.cloud.json",
    "start:cloud": "node dist/scripts/migrate.js && node dist/src/server.js",
    "start": "node --env-file=.env dist/src/server.js",
    "setup:local": "tsx scripts/setup-local.ts",
    "db:start": "tsx --env-file=.env scripts/database.ts",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "db:seed:demo": "tsx --env-file=.env scripts/seed-demo.ts",
    "db:seed:showcase": "tsx --env-file=.env --env-file-if-exists=../.local/demo.env scripts/seed-showcase.ts",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "preview": "tsx scripts/preview.ts",
    "format": "prettier --write src scripts test support"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "fastify": "^5.12.5",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fastify/static": "^10.1.5",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
